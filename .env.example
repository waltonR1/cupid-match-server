# Cupid Match local environment override.
# Copy this file to `.env` in the `cupid-match-server` directory and fill real values locally.
# `.env` is ignored by Git; do not commit secrets such as sk_*, whsec_*, Twilio tokens, SMTP passwords.

# Database
CUPID_DB_URL=
CUPID_DB_USERNAME=
CUPID_DB_PASSWORD=
CUPID_DB_SLAVE_ENABLED=false
CUPID_DB_SLAVE_URL=
CUPID_DB_SLAVE_USERNAME=
CUPID_DB_SLAVE_PASSWORD=

# Redis
CUPID_REDIS_HOST=
CUPID_REDIS_PORT=6379
CUPID_REDIS_DATABASE=0
CUPID_REDIS_USERNAME=
CUPID_REDIS_PASSWORD=

# Public image storage: local or s3 (AWS S3 and Cloudflare R2 are supported)
CUPID_STORAGE_TYPE=local
CUPID_STORAGE_LOCAL_ROOT=
# Optional CDN/public object base URL. Leave empty to proxy reads through the backend.
CUPID_STORAGE_PUBLIC_BASE_URL=
CUPID_STORAGE_S3_BUCKET=
CUPID_STORAGE_S3_PRIVATE_BUCKET=
CUPID_STORAGE_S3_REGION=auto
CUPID_STORAGE_S3_ENDPOINT=
CUPID_STORAGE_S3_ACCESS_KEY=
CUPID_STORAGE_S3_SECRET_KEY=
CUPID_STORAGE_S3_PATH_STYLE_ACCESS=false

# Verification email
CUPID_MAIL_FROM=
CUPID_SMTP_HOST=
CUPID_SMTP_PORT=587
CUPID_SMTP_USERNAME=
CUPID_SMTP_PASSWORD=

# Verification SMS
CUPID_SMS_PROVIDER=twilio
CUPID_TWILIO_ACCOUNT_SID=
CUPID_TWILIO_AUTH_TOKEN=
CUPID_TWILIO_API_KEY=
CUPID_TWILIO_API_SECRET=
CUPID_TWILIO_MESSAGING_SERVICE_SID=

# Stripe Checkout and webhook
CUPID_STRIPE_ENABLED=false
CUPID_STRIPE_ENVIRONMENT=test
CUPID_STRIPE_SECRET_KEY=
CUPID_STRIPE_WEBHOOK_SECRET=
CUPID_STRIPE_SUCCESS_URL=
CUPID_STRIPE_CANCEL_URL=
